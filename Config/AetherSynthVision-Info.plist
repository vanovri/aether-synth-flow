<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleDisplayName</key>
    <string>AetherSynth Spatial</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>AetherSynth Spatial connects to 4-channel Bluetooth Low Energy EEG headbands (TP9, AF7, AF8, TP10) for real-time cortical entrainment, ocular blink rejection, and Bispectral Index telemetry.</string>
    <key>NSHandsTrackingUsageDescription</key>
    <string>AetherSynth reads bimanual pinch distance and wrist roll to modulate binaural entrainment frequencies and spatial filter harmonics in real time.</string>
    <key>NSWorldSensingUsageDescription</key>
    <string>AetherSynth anchors stereoscopic curl-noise aurora fields to your physical room coordinates.</string>
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationPreferredDefaultSceneSessionRole</key>
        <string>UIWindowSceneSessionRoleApplication</string>
        <key>UIApplicationSupportsMultipleScenes</key>
        <true/>
        <key>UISceneConfigurations</key>
        <dict>
            <key>UIWindowSceneSessionRoleApplication</key>
            <array>
                <dict>
                    <key>UISceneConfigurationName</key>
                    <string>Default Spatial Window</string>
                </dict>
            </array>
            <key>UIWindowSceneSessionRoleVolumetricApplication</key>
            <array>
                <dict>
                    <key>UISceneConfigurationName</key>
                    <string>Volumetric Orbital Stage</string>
                </dict>
            </array>
            <key>CPSceneSessionRoleImmersiveSpaceApplication</key>
            <array>
                <dict>
                    <key>UISceneConfigurationName</key>
                    <string>Curl Aurora Immersive Space</string>
                </dict>
            </array>
        </dict>
    </dict>
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
    </array>
</dict>
</plist>
